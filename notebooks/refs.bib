@article{alam2021,
  title    = {Corporate failure prediction: An evaluation of deep learning vs discrete hazard models},
  journal  = {Journal of International Financial Markets, Institutions and Money},
  volume   = {75},
  pages    = {101455},
  year     = {2021},
  issn     = {1042-4431},
  doi      = {https://doi.org/10.1016/j.intfin.2021.101455},
  url      = {https://www.sciencedirect.com/science/article/pii/S1042443121001621},
  author   = {Nurul Alam and Junbin Gao and Stewart Jones},
  keywords = {Panel data, Corporate failure prediction, Financial ratios, Market variables deep learning, Convolutional neural networks},
  abstract = {In recent years, deep learning has emerged as a dominant machine learning method used in a variety of applications. In this paper, we propose an optimum deep learning model using a panel data structure to predict corporate failure. We compare deep learning with the more traditional discrete hazard model which has been widely applied in the finance literature in panel data applications. Based on a sample of 641,667 firm-month observations of North American listed companies between 2001 and 2018 and including many financial and market-based feature variables, our deep learning model can predict corporate failure with 93.71% accuracy. This is significantly more accurate than the discrete hazard model which predicted corporate failure with only 86.95% accuracy.}
}
