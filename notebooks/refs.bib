@article{greenlee2000,
  author   = {Greenlee, Janet S. and Trussel, John M.},
  title    = {Predicting the Financial Vulnerability of Charitable Organizations},
  journal  = {Nonprofit Management and Leadership},
  volume   = {11},
  number   = {2},
  pages    = {199-210},
  doi      = {https://doi.org/10.1002/nml.11205},
  url      = {https://onlinelibrary.wiley.com/doi/abs/10.1002/nml.11205},
  eprint   = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/nml.11205},
  abstract = {Abstract This article describes a model that can be used to predict which nonprofit organizations are vulnerable to financial problems. The model is based on financial indicators developed by Tuckman and Chang (1991), adapts methodologies that have been developed in the for-profit sector to predict financial vulnerability, and was empirically tested using a multiyear Internal Revenue Service database provided by the National Center for Charitable Statistics. Both internal and external stakeholders can use the model when making allocation decisions during the strategic planning process and in evaluating financial risk.},
  year     = {2000}
}

@article{trussel2002,
  author   = {Trussel, John M.},
  title    = {Revisiting the Prediction of Financial Vulnerability},
  journal  = {Nonprofit Management and Leadership},
  volume   = {13},
  number   = {1},
  pages    = {17-31},
  doi      = {https://doi.org/10.1002/nml.13103},
  url      = {https://onlinelibrary.wiley.com/doi/abs/10.1002/nml.13103},
  eprint   = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/nml.13103},
  abstract = {Abstract Whether or not a nonprofit organization is vulnerable to financial problems is a concern of all stakeholders of the organization. Recently, Greenlee and Trussel (2000) and Trussel and Greenlee (2001) expanded Tuckman and Chang's work (1991) to predict which organizations are financially vulnerable. This article extends the work of these authors by developing a model of financial vulnerability that includes four financial indicators, controls for the sector to which an organization belongs, and is based on a sample of over ninety-four thousand organizations. The model is useful as a screening, monitoring, and attention-getting device.},
  year     = {2002}
}

